{
  "name": "cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -H 0.0.0.0 -p 3001",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "vercel-build": "DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.mts tests/unit",
    "test:int": "vitest run --config ./vitest.config.mts tests/int"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/email-resend": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/storage-vercel-blob": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.82.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
