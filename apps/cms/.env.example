# ---------- CMS (apps/cms) ----------
# Neon via the Vercel integration sets both of these automatically.
DATABASE_URL="postgresql://news:news@localhost:5432/news"          # pooled — used at runtime
DATABASE_URL_UNPOOLED=""                                            # direct — used by `payload migrate` on deploy
DATABASE_POOL_MAX=10

# 32+ random characters: `openssl rand -base64 48`. Rotating it signs everyone out.
PAYLOAD_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
PUBLICATION_NAME="The Daily Brief"

CMS_URL="http://localhost:3001"   # this app's public URL, e.g. https://editor.example.com
WEB_URL="http://localhost:3000"   # the public website, e.g. https://www.example.com

# Shared with the web app: lets the CMS purge website caches on publish.
REVALIDATE_SECRET="replace-with-random-string"
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/publish-scheduled.
CRON_SECRET="replace-with-random-string"

# Local dev: Payload "push" syncs schema automatically. Keep false if you also run migrations locally.
PAYLOAD_DB_PUSH=false

# Media storage — Vercel Blob (set automatically when you connect a Blob store). Empty = local disk (dev only).
BLOB_READ_WRITE_TOKEN=""

# Email (password resets) — Resend. Empty = emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="news@example.com"

# ---------- Payments (server-side only; configure one or both) ----------
PAYMENT_DEFAULT_PROVIDER="razorpay"     # razorpay | stripe — shown first on the subscribe page
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""              # webhook URL: $CMS_URL/api/billing/webhooks/razorpay
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""                # webhook URL: $CMS_URL/api/billing/webhooks/stripe
