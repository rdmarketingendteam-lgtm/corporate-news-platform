# ---------- Website (apps/web) ----------
NEXT_PUBLIC_PUBLICATION_NAME="The Daily Brief"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # canonical public URL, e.g. https://www.example.com

# Server-side only — never exposed to the browser.
CMS_URL="http://localhost:3001"
REVALIDATE_SECRET="same-value-as-the-cms"

# Google Ad Manager. Leave the network code empty to disable ads entirely.
NEXT_PUBLIC_GAM_NETWORK_CODE=""          # e.g. 21812345678
NEXT_PUBLIC_GAM_UNIT_PREFIX="news"       # ad units: /<network>/<prefix>/{top,in_article,rail,footer}
# builtin = this site's consent banner. external = a Google-certified TCF CMP (required for EEA/UK/Swiss traffic).
NEXT_PUBLIC_CMP_MODE="builtin"
# Lines for /ads.txt, separated by \n
ADS_TXT=""
