{
  "name": "corporate-news-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter cms dev",
    "dev:all": "node start-dev.js",
    "scraper": "apps\\scraper\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir apps/scraper --host 0.0.0.0 --port 8000",
    "scraper:worker": "apps\\scraper\\.venv\\Scripts\\python.exe apps/scraper/continuous_worker.py",
    "build": "pnpm --filter web build",
    "build:cms": "pnpm --filter cms build",
    "build:all": "pnpm --filter cms build && pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:int": "pnpm --filter cms test:int"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild", "unrs-resolver"]
  }
}
